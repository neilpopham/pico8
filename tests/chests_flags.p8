pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
extcmd('rec')

function _init()
    p = {
        s = 9,
        x = 100,
        y = 100
    }
    particles = {}
end

function _update60()
    local dx, dy, tx, ty, valid = 0, 0

    if btn(0) then dx = -1 end
    if btn(1) then dx = 1 end
    if btn(2) then dy = -1 end
    if btn(3) then dy = 1 end

    if dx > 0 then
        tx = (p.x + dx + 7) \ 8
        valid = 193
    else
        tx = (p.x + dx) \ 8
        valid = 129
    end
    for ty in all({ p.y \ 8, (p.y + 7) \ 8 }) do
        local sprite = mget(tx, ty)
        local flags = fget(sprite)
        if flags & 1 > 0 then
            if flags == valid then open_chest(tx, ty, sprite) end
            dx = 0
        end
    end
    p.x += dx

    if dy > 0 then
        ty = (p.y + dy + 7) \ 8
        valid = 65
    else
        ty = (p.y + dy) \ 8
        valid = 1
    end
    for tx in all({ p.x \ 8, (p.x + 7) \ 8 }) do
        local sprite = mget(tx, ty)
        local flags = fget(sprite)
        if flags & 1 > 0 then
            if flags == valid then open_chest(tx, ty, sprite) end
            dy = 0
        end
    end

    p.y += dy

    for p in all(particles) do
        p.x += cos(p.a) * 2
        p.y -= sin(p.a) * 2
        p.ttl -= 1
        if p.ttl == 0 then del(particles, p) end
    end
end

function _draw()
    cls()
    map()
    spr(p.s, p.x, p.y)
    for p in all(particles) do
        rectfill(p.x, p.y, p.x + 3, p.y + 3, 9)
    end
end

function open_chest(tx, ty, sprite)
    mset(tx, ty, sprite + 4)
    for i = 1, 20 do
        add(
            particles,
            {
                x = tx * 8 + 4,
                y = ty * 8 + 4,
                ttl = ceil(rnd(20) + 5),
                a = rnd()
            }
        )
    end
end

