pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

local __tif__="2:14:2:0,21:9:2:0,37:8:2:0,58:8:2:0,72:7:2:0,88:4:2:0,105:14:2:0,122:9:2:0,7:30:2:0,22:20:2:0,40:23:2:0,56:25:2:0,71:21:2:0,88:25:2:0,106:22:2:0,118:20:2:0"

starts = {}
for idx, tile in ipairs(split(__tif__)) do
    local x, y, s, f = unpack(split(tile, ":"))
    starts[idx] = {x % 16, y % 16}
end

level = 0
cx = 0
cy = 0
px = 0
py = 0
dt = 1

function set_camera(level)
    cx = (level % 8) * 128
    cy = (level \ 8) * 128
    local start = starts[level + 1]
    px = cx + (start[1] * 8)
    py = cy + (start[2] * 8)
end

function _init()
    set_camera(level)
end

function _update60()
    if btnp() > 0 then
        level += 1
        if level == 16 then level = 0 end
        set_camera(level)
    end
    dt += 1
end

function _draw()
    cls()
    camera(cx, cy)
    map()
    spr(2, px, py)
end


