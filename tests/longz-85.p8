pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 velx=0
 vely=0
 x=64
 y=64
 sprite=1
 t=0.5
end

function animate()
 sprite+=t
 if sprite>=4 then sprite=1 end
end

function _update()
 vely+=0.7
 local oy=vely>0 and 7 or 0
 for tx in all({x\8,(x+7)\8}) do
	 if map_collision(tx,(y+oy+vely)\8,0) then
	  if oy==0 then 
	  	y=y\8*8
	 	end
	 	vely=0
	 end
	end
 y+=vely
 local ox=velx>0 and 7 or 0
 for ty in all({y\8,(y+7)\8}) do
	 if map_collision((x+ox+velx)\8,ty,0) then
	 	velx=0
	 end
	end  
 x+=velx
 move() 
end

function _draw()
 cls(12)
 map()
 print("this is my first project on \n pico8", 6, 63, 0)
 spr(sprite, x, y)
end

function move()
 if y>=120 then
  y=120
  if vely>1.5 then
   sfx(0)
  end
  vely=0
 end
 
 if btnp(🅾️) and y==120 then
  vely=-7
  animate()
 end
 if btn(⬅️) then
  velx=-4
  animate()
 elseif btn(➡️) then
  velx=4
  animate()
 else
  velx=0
  left=17
  right=20
  sprite=1
 end
end

function map_collision( tile_x, tile_y, flag )
  return fget( mget(tile_x,tile_y), flag )
end
